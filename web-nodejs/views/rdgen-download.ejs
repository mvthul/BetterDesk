<%
// rdgen build status / download portal — faithful 1:1 port of upstream waiting.html / generated.html / failure.html
// No auth required — UUID is the access token.
const run = rdgenRun;
const filename = run.filename || 'rustdesk';
const platform = run.platform || 'windows';
const uuid = run.uuid;
const logUrl = run.log_url ||
    (run.github_run_id && process.env.GHUSER && process.env.REPONAME
        ? `https://github.com/${process.env.GHUSER}/${process.env.REPONAME}/actions/runs/${run.github_run_id}`
        : '');

const terminalStatuses = ['success', 'failure', 'cancelled', 'timed_out', 'skipped', 'action_required'];
const failStatuses     = ['failure', 'cancelled', 'timed_out', 'skipped', 'action_required'];
const isSuccess = run.status === 'success';
const isFailed  = failStatuses.includes(run.status);
const isWaiting = !isSuccess && !isFailed;
%><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="pageTitle">
        <%= isSuccess ? 'Build Generated Successfully' : isFailed ? 'Build Failure' : 'Generating Build' %>
    </title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }
        body.is-failed {
            background: linear-gradient(135deg, #ffcfcf 0%, #e2c3c3 100%);
        }

        /* ── Platform logos ─────────────────────────────────────────────────── */
        .platform-logo {
            width: 150px;
            height: 150px;
            margin-bottom: 30px;
            display: none;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));
            transition: transform 0.3s ease;
        }
        .platform-logo:hover { transform: scale(1.1); }

        /* ── Waiting state ──────────────────────────────────────────────────── */
        .loading-text  { color: #333; font-weight: 600; margin-bottom: 20px; }
        .status-text   { color: #666; font-size: 0.9em; }
        .macos-note    { color: #666; font-size: 0.9em; margin-top: 15px; background: rgba(255,255,255,0.7); padding: 10px; border-radius: 8px; }
        .loading-spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            width: 40px; height: 40px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .progress-bar { width: 300px; height: 10px; background-color: #e0e0e0; border-radius: 5px; overflow: hidden; margin: 20px auto; }
        .progress-bar-fill { width: 0%; height: 100%; background-color: #3498db; transition: width 0.5s ease-in-out; }
        .log-container {
            margin-top: 30px; padding: 15px;
            background: rgba(255,255,255,0.5); border-radius: 12px;
            font-size: 0.85em; max-width: 320px; margin-left: auto; margin-right: auto;
            border: 1px solid rgba(0,0,0,0.05);
        }
        .log-link {
            color: #3498db; text-decoration: none; font-weight: 600;
            display: inline-flex; align-items: center; gap: 5px;
        }
        .log-link:hover { text-decoration: underline; }

        /* ── Success state ──────────────────────────────────────────────────── */
        .success-text   { color: #333; font-weight: 600; margin-bottom: 20px; }
        .download-section {
            background: rgba(255,255,255,0.8);
            padding: 20px; border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-top: 20px;
        }
        .download-link {
            display: block; margin: 10px 0; padding: 10px;
            background-color: #3498db; color: white;
            text-decoration: none; border-radius: 5px;
            transition: background-color 0.3s ease;
        }
        .download-link:hover { background-color: #2980b9; }
        .platform-note { color: #666; font-size: 0.9em; margin-top: 15px; background: rgba(255,255,255,0.7); padding: 10px; border-radius: 8px; }

        /* ── Failure state ──────────────────────────────────────────────────── */
        .error-container {
            background: white; border-radius: 12px; padding: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1); max-width: 500px; width: 90%;
        }
        .error-header   { color: #c0392b; font-weight: 700; margin-bottom: 10px; font-size: 1.5em; }
        .warning-box {
            background-color: #fff3cd; border: 1px solid #ffeeba; color: #856404;
            padding: 15px; border-radius: 8px; margin-bottom: 20px;
            font-size: 0.9em; text-align: left;
        }
        .download-section-fail {
            background: #f8f9fa; padding: 15px; border-radius: 10px; border: 1px dashed #ccc;
        }
        .download-link-fail {
            display: block; margin: 10px 0; padding: 12px;
            background-color: #34495e; color: white;
            text-decoration: none; border-radius: 5px; transition: opacity 0.3s ease;
        }
        .download-link-fail:hover { opacity: 0.8; }
    </style>
</head>
<body class="<%= isFailed ? 'is-failed' : '' %>">

    <!-- Platform logo SVGs (shown/hidden by JS) -->
    <svg id="windowsLogo" class="platform-logo" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="windowsGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#00A4EF;stop-opacity:1"/>
                <stop offset="100%" style="stop-color:#0078D7;stop-opacity:1"/>
            </linearGradient>
        </defs>
        <rect width="256" height="256" rx="50" ry="50" fill="url(#windowsGradient)"/>
        <path d="M60 60 L196 60 L196 196 L60 196 Z" fill="white" opacity="0.2"/>
        <path d="M128 60 L196 60 L196 128 Z" fill="white" opacity="0.1"/>
        <text x="128" y="200" font-family="Arial" font-size="50" font-weight="bold" text-anchor="middle" fill="white">Win</text>
    </svg>

    <svg id="macosLogo" class="platform-logo" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="macosGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#A2AAAD;stop-opacity:1"/>
                <stop offset="100%" style="stop-color:#4A4A4A;stop-opacity:1"/>
            </linearGradient>
        </defs>
        <rect width="256" height="256" rx="50" ry="50" fill="url(#macosGradient)"/>
        <text x="128" y="200" font-family="Arial" font-size="50" font-weight="bold" text-anchor="middle" fill="white">Mac</text>
    </svg>

    <svg id="linuxLogo" class="platform-logo" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="linuxGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#FFA500;stop-opacity:1"/>
                <stop offset="100%" style="stop-color:#FF4500;stop-opacity:1"/>
            </linearGradient>
        </defs>
        <rect width="256" height="256" rx="50" ry="50" fill="url(#linuxGradient)"/>
        <text x="128" y="200" font-family="Arial" font-size="50" font-weight="bold" text-anchor="middle" fill="white">Linux</text>
    </svg>

    <svg id="androidLogo" class="platform-logo" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="androidGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#A4C639;stop-opacity:1"/>
                <stop offset="100%" style="stop-color:#78C257;stop-opacity:1"/>
            </linearGradient>
        </defs>
        <rect width="256" height="256" rx="50" ry="50" fill="url(#androidGradient)"/>
        <text x="128" y="200" font-family="Arial" font-size="50" font-weight="bold" text-anchor="middle" fill="white">Android</text>
    </svg>

    <!-- ── WAITING ─────────────────────────────────────────────────────────── -->
    <% if (isWaiting) { %>
    <div id="waitingView">
        <h1 style="margin: 0 0 6px 0; font-size: 1.6rem; font-weight: 700; color: #111827;"><%= run.appname || run.filename || 'RustDesk Client' %></h1>
        <h2 class="loading-text" style="font-size: 1.1rem; color: #4b5563; font-weight: 500;">Build in Progress</h2>
        <div class="loading-spinner"></div>
        <div id="jobProgressWrapper" style="display:none;max-width:380px;margin:15px auto;text-align:left;">
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.82rem;color:#4b5563;margin-bottom:4px;">
                <span id="jobProgressText" style="color:#3b82f6;font-weight:600;">0/0 jobs completed</span>
                <span id="activeJobText" style="font-style:italic;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#6b7280;"></span>
            </div>
            <div style="width:100%;height:6px;background:#e5e7eb;border-radius:3px;overflow:hidden;">
                <div id="jobProgressFill" style="height:6px;background:#3b82f6;border-radius:3px;width:0%;transition:width .5s ease;"></div>
            </div>
        </div>
        <div id="indeterminateProgress" class="progress-bar">
            <div id="progressBarFill" class="progress-bar-fill"></div>
        </div>
        <p class="status-text">This can take 30–45 minutes. You can leave this page open or come back later.</p>
        <p class="status-text">Status: <span id="statusText" style="text-transform:capitalize;font-weight:600;"><%= run.status || 'queued' %></span></p>

        <% if (logUrl) { %>
        <div class="log-container">
            <p style="margin: 0 0 8px 0; color: #888;">Technical View</p>
            <a href="<%= logUrl %>" target="_blank" class="log-link">
                View GitHub Action Logs
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
        </div>
        <% } %>
    </div>

    <div id="macosNote" class="macos-note" style="display:none">
        Note for macOS users: Generating an executable may require additional steps or permissions.
    </div>
    <% } %>

    <!-- ── SUCCESS ─────────────────────────────────────────────────────────── -->
    <% if (isSuccess) { %>
    <div id="successView">
        <h1 style="margin: 0 0 6px 0; font-size: 1.6rem; font-weight: 700; color: #111827;"><%= run.appname || run.filename || 'RustDesk Client' %></h1>
        <h2 class="success-text" style="font-size: 1.1rem; color: #16a34a; font-weight: 600;">Build Generated Successfully</h2>
        <div class="download-section">
            <% if (platform === 'windows') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.exe" class="download-link">Download <%= filename %>.exe</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.msi" class="download-link">Download <%= filename %>.msi</a>
            <% } else if (platform === 'windows-x86') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.exe" class="download-link">Download <%= filename %>.exe</a>
            <% } else if (platform === 'linux') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.deb" class="download-link">Download <%= filename %>-x86_64.deb</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.rpm" class="download-link">Download <%= filename %>-x86_64.rpm</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-suse-x86_64.rpm" class="download-link">Download <%= filename %>-suse-x86_64.rpm</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.pkg.tar.zst" class="download-link">Download <%= filename %>-x86_64.pkg.tar.zst</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.deb" class="download-link">Download <%= filename %>-aarch64.deb</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.rpm" class="download-link">Download <%= filename %>-aarch64.rpm</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-suse-aarch64.rpm" class="download-link">Download <%= filename %>-suse-aarch64.rpm</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.pkg.tar.zst" class="download-link">Download <%= filename %>-aarch64.pkg.tar.zst</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.AppImage" class="download-link">Download <%= filename %>-x86_64.AppImage</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.AppImage" class="download-link">Download <%= filename %>-aarch64.AppImage</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.flatpak" class="download-link">Download <%= filename %>-x86_64.flatpak</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.flatpak" class="download-link">Download <%= filename %>-aarch64.flatpak</a>
            <% } else if (platform === 'android') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.apk" class="download-link">Download <%= filename %>-aarch64.apk</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.apk" class="download-link">Download <%= filename %>-x86_64.apk</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-armv7.apk" class="download-link">Download <%= filename %>-armv7.apk</a>
            <% } else if (platform === 'macos') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.dmg" class="download-link">Download <%= filename %>-x86_64.dmg</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.dmg" class="download-link">Download <%= filename %>-aarch64.dmg</a>
            <% } else { %>
                <p>Error: No file generated for platform '<%= platform %>'.</p>
            <% } %>
        </div>
    </div>
    <div id="platformNote" class="platform-note" style="display:none"></div>
    <% } %>

    <!-- ── FAILURE ─────────────────────────────────────────────────────────── -->
    <% if (isFailed) { %>
    <div class="error-container">
        <h1 style="margin: 0 0 6px 0; font-size: 1.6rem; font-weight: 700; color: #111827;"><%= run.appname || run.filename || 'RustDesk Client' %></h1>
        <h2 class="error-header" style="font-size: 1.1rem; margin-top: 4px;">Workflow Interrupted</h2>
        <div class="warning-box">
            <strong>Warning:</strong> The build process did not complete successfully. Some files may be missing. You can attempt to download the available files below.
        </div>
        <div class="download-section-fail">
            <% if (platform === 'windows') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.exe" class="download-link-fail">Download <%= filename %>.exe</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.msi" class="download-link-fail">Download <%= filename %>.msi</a>
            <% } else if (platform === 'windows-x86') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>.exe" class="download-link-fail">Download <%= filename %>.exe</a>
            <% } else if (platform === 'linux') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.deb" class="download-link-fail">Download <%= filename %>-x86_64.deb</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.rpm" class="download-link-fail">Download <%= filename %>-x86_64.rpm</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.AppImage" class="download-link-fail">Download <%= filename %>-x86_64.AppImage</a>
            <% } else if (platform === 'android') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.apk" class="download-link-fail">Download <%= filename %>-aarch64.apk</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.apk" class="download-link-fail">Download <%= filename %>-x86_64.apk</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-armv7.apk" class="download-link-fail">Download <%= filename %>-armv7.apk</a>
            <% } else if (platform === 'macos') { %>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-x86_64.dmg" class="download-link-fail">Download <%= filename %>-x86_64.dmg</a>
                <a href="/api/generator/rdgen/download/<%= uuid %>/<%= filename %>-aarch64.dmg" class="download-link-fail">Download <%= filename %>-aarch64.dmg</a>
            <% } else { %>
                <p>No files available.</p>
            <% } %>
        </div>
        <% if (logUrl) { %>
        <a href="<%= logUrl %>" target="_blank" class="log-link" style="display:inline-block;margin-top:15px;color:#3498db;text-decoration:none;font-size:0.85em;">
            Check GitHub Logs for error details ↗
        </a>
        <% } %>
        <div id="platformNote" class="platform-note" style="display:none;margin-top:15px;color:#666;font-size:0.85em;"></div>
        <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">
        <a href="/generator" style="font-size: 0.9em; color: #666; text-decoration: none;">← Return to Form</a>
    </div>
    <% } %>

    <script id="buildConfig" type="application/json"><%- JSON.stringify({ platform, uuid, filename, isWaiting }) %></script>
    <script>
    (function () {
        const buildConfig = JSON.parse(document.getElementById('buildConfig').textContent);
        const { platform, uuid, filename, isWaiting } = buildConfig;

        // ── Platform logo & title ──────────────────────────────────────────
        function updatePlatformUI() {
            const logos = {
                'windows':     document.getElementById('windowsLogo'),
                'windows-x86': document.getElementById('windowsLogo'),
                'macos':       document.getElementById('macosLogo'),
                'linux':       document.getElementById('linuxLogo'),
                'android':     document.getElementById('androidLogo'),
            };
            Object.values(logos).forEach(l => { if (l) l.style.display = 'none'; });

            const p = platform.toLowerCase();
            const logo = logos[p];
            if (logo) logo.style.display = 'block';

            const titleEl = document.getElementById('pageTitle');
            const platformNote = document.getElementById('platformNote');

            if (p === 'macos') {
                if (titleEl && isWaiting) titleEl.textContent = 'Generating MacOS Build';
                else if (titleEl) titleEl.textContent = 'MacOS Build Generated';
                const note = document.getElementById('macosNote');
                if (note) note.style.display = 'block';
                if (platformNote) {
                    platformNote.textContent = 'Note: For macOS, you may need to adjust security settings to run the application.';
                    platformNote.style.display = 'block';
                }
            } else if (p === 'windows' || p === 'windows-x86') {
                if (titleEl && isWaiting) titleEl.textContent = 'Generating Windows Build';
                else if (titleEl) titleEl.textContent = 'Windows Build Generated';
                if (platformNote) {
                    platformNote.textContent = 'Note: You might need to disable SmartScreen or adjust Windows security settings.';
                    platformNote.style.display = 'block';
                }
            } else if (p === 'linux') {
                if (titleEl && isWaiting) titleEl.textContent = 'Generating Linux Build';
                else if (titleEl) titleEl.textContent = 'Linux Build Generated';
                if (platformNote) {
                    platformNote.textContent = 'Note: Ensure you have the necessary dependencies installed.';
                    platformNote.style.display = 'block';
                }
            } else if (p === 'android') {
                if (titleEl && isWaiting) titleEl.textContent = 'Generating Android Build';
                else if (titleEl) titleEl.textContent = 'Android Build Generated';
                if (platformNote) {
                    platformNote.textContent = 'Note: You may need to enable "Unknown Sources" in device settings.';
                    platformNote.style.display = 'block';
                }
            }
        }

        updatePlatformUI();

        // ── Waiting: live status poll & job progress updates ─────────────────
        if (isWaiting) {
            const TERMINAL = ['success', 'failure', 'cancelled', 'timed_out', 'skipped', 'action_required'];
            let pollTimer = null;

            async function poll() {
                try {
                    const r = await fetch(`/api/generator/rdgen/status/${uuid}`, { credentials: 'include' });
                    if (!r.ok) return;
                    const j = await r.json();
                    if (!j || !j.found) return;

                    const status = j.status;
                    const statusEl = document.getElementById('statusText');
                    if (statusEl) {
                        let label = status;
                        if (j.gh_status === 'in_progress') label = 'in progress';
                        else if (j.gh_status === 'queued') label = 'queued';
                        statusEl.textContent = label;
                    }

                    // Update live job progress elements
                    if (j.gh_jobs_total > 0) {
                        const wrapper = document.getElementById('jobProgressWrapper');
                        const indeterminate = document.getElementById('indeterminateProgress');
                        const progressText = document.getElementById('jobProgressText');
                        const activeJobText = document.getElementById('activeJobText');
                        const progressFill = document.getElementById('jobProgressFill');

                        if (wrapper) wrapper.style.display = 'block';
                        if (indeterminate) indeterminate.style.display = 'none';
                        if (progressText) progressText.textContent = `${j.gh_jobs_completed}/${j.gh_jobs_total} jobs completed`;
                        if (activeJobText) activeJobText.textContent = j.gh_active_job ? `▶ ${j.gh_active_job}` : '';
                        if (progressFill) {
                            const pct = Math.round((j.gh_jobs_completed / j.gh_jobs_total) * 100);
                            progressFill.style.width = `${pct}%`;
                            if (j.gh_jobs_failed > 0) progressFill.style.backgroundColor = '#ef4444';
                        }
                    }

                    if (TERMINAL.includes(status)) {
                        clearInterval(pollTimer);
                        window.location.reload();
                    }
                } catch (_) {}
            }

            // Poll every 15 seconds
            pollTimer = setInterval(poll, 15000);

            // Initial quick poll to populate status immediately
            setTimeout(poll, 1200);
        }
    })();
    </script>
</body>
</html>
