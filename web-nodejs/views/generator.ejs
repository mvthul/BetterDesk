<% const realClientPanel = include('partials/real-client-generator'); %>
<%- include('layouts/main', {
    title: _('nav.generator'),
    pageStyles: ['pages', 'generator'],
    pageScripts: ['generator', 'real-client-generator'],
    currentPage: 'generator',
    breadcrumb: [{ label: _('nav.generator') }],
    body: `
        <div class="page-header">
            <h1 class="page-title">
                <span class="material-icons">tune</span>
                ${_('generator.title')}
            </h1>
            <p class="page-subtitle">${_('generator.subtitle')}</p>
        </div>

        <div class="generator-layout">
            <!-- Left column: bundle list -->
            <aside class="generator-bundles card">
                <div class="card-header">
                    <h2 class="card-title">
                        <span class="material-icons">inventory_2</span>
                        ${_('generator.bundles_title')}
                    </h2>
                    <button id="gen-new-bundle" class="btn btn-primary btn-sm" title="${_('generator.agent_client_new_bundle')}">
                        <span class="material-icons">add</span>
                        ${_('generator.agent_client_tab')}
                    </button>
                    <div class="generator-bundle-actions">
                        <button id="gen-new-support" class="btn btn-secondary btn-sm" title="${_('generator.support_agent_new_bundle')}">
                            <span class="material-icons">support_agent</span>
                            ${_('generator.support_agent_tab')}
                        </button>
                        <button id="gen-new-rdclient" class="btn btn-secondary btn-sm" title="${_('generator.rdclient_new_bundle')}">
                            <span class="material-icons">connected_tv</span>
                            ${_('generator.rdclient_tab')}
                        </button>
                        <button id="gen-new-real-client" class="btn btn-secondary btn-sm" title="Open RustDesk Client Generator">
                            <span class="material-icons">desktop_windows</span>
                            RustDesk Client Generator
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="gen-bundle-list" class="bundle-list">
                        <p class="text-muted">${_('generator.loading')}</p>
                    </div>
                </div>
            </aside>

            <!-- Right column: editor + preview -->
            <section class="generator-editor card">
                <div class="card-header">
                    <h2 class="card-title" id="gen-editor-title">
                        <span class="material-icons">edit</span>
                        ${_('generator.editor_title')}
                    </h2>
                    <div class="editor-actions">
                        <button id="gen-revoke-btn" class="btn btn-warning btn-sm hidden">
                            <span class="material-icons">block</span>
                            ${_('generator.revoke')}
                        </button>
                        <button id="gen-delete-btn" class="btn btn-danger btn-sm hidden">
                            <span class="material-icons">delete</span>
                            ${_('common.delete')}
                        </button>
                        <button id="gen-save-btn" class="btn btn-primary btn-sm" disabled>
                            <span class="material-icons">save</span>
                            ${_('common.save')}
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="gen-empty-state" class="empty-state">
                        <span class="material-icons">touch_app</span>
                        <p>${_('generator.empty_state')}</p>
                    </div>

                    <div id="gen-editor-form" class="editor-form hidden">
                        <div class="editor-grid">
                            <div class="editor-fields">
                                <div class="form-group">
                                    <label class="form-label" for="gen-name">${_('generator.bundle_name')}</label>
                                    <input type="text" id="gen-name" class="form-input" maxlength="100" required>
                                    <p class="form-hint">${_('generator.bundle_name_hint')}</p>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="gen-slug">${_('generator.short_link')}</label>
                                    <div class="download-link-row">
                                        <span class="input-prefix">/d/</span>
                                        <input type="text" id="gen-slug" class="form-input" maxlength="32"
                                               pattern="[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?"
                                               autocomplete="off" spellcheck="false">
                                    </div>
                                    <p class="form-hint">${_('generator.short_link_hint')}</p>
                                </div>

                                <h3 class="section-title">${_('generator.connection_section')}</h3>

                                <div class="form-group">
                                    <label class="form-label" for="gen-server-host">${_('generator.server_host')}</label>
                                    <input type="text" id="gen-server-host" class="form-input" maxlength="253"
                                           placeholder="${_('generator.server_host_placeholder')}" required>
                                    <p class="form-hint">${_('generator.server_host_hint')}</p>
                                </div>

                                <div class="form-row">
                                    <div class="form-group form-group-checkbox">
                                        <label class="form-label">
                                            <input type="checkbox" id="gen-use-https" checked>
                                            ${_('generator.use_https')}
                                        </label>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">${_('generator.enrollment_token')}</label>
                                        <input type="text" id="gen-token-mask" class="form-input" readonly
                                               placeholder="${_('generator.enrollment_token_pending')}">
                                        <p class="form-hint">${_('generator.enrollment_token_hint')}</p>
                                    </div>
                                </div>

                                <h3 class="section-title">${_('generator.branding_section')}</h3>

                                <div class="form-group">
                                    <label class="form-label" for="gen-company">${_('generator.company_name')}</label>
                                    <input type="text" id="gen-company" class="form-input" maxlength="100" required>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="gen-short-text">${_('generator.short_text')}</label>
                                    <textarea id="gen-short-text" class="form-input" rows="2" maxlength="500"></textarea>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="form-label" for="gen-email">${_('generator.contact_email')}</label>
                                        <input type="email" id="gen-email" class="form-input" maxlength="200">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-phone">${_('generator.contact_phone')}</label>
                                        <input type="text" id="gen-phone" class="form-input" maxlength="200">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="gen-url">${_('generator.contact_url')}</label>
                                    <input type="url" id="gen-url" class="form-input" maxlength="200" placeholder="https://example.com">
                                </div>

                                <div class="form-group">
                                    <label class="form-label" for="gen-logo">${_('generator.logo')}</label>
                                    <input type="file" id="gen-logo" class="form-input" accept="image/png,image/jpeg,image/svg+xml,image/webp">
                                    <p class="form-hint">${_('generator.logo_hint')}</p>
                                    <button type="button" id="gen-logo-clear" class="btn btn-ghost btn-sm hidden">
                                        <span class="material-icons">close</span>
                                        ${_('generator.logo_clear')}
                                    </button>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="form-label" for="gen-primary">${_('generator.primary_color')}</label>
                                        <input type="color" id="gen-primary" class="form-input form-color" value="#2563eb">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-accent">${_('generator.accent_color')}</label>
                                        <input type="color" id="gen-accent" class="form-input form-color" value="#1e293b">
                                    </div>
                                </div>

                                <div class="form-row color-grid">
                                    <div class="form-group">
                                        <label class="form-label" for="gen-bg">${_('generator.background_color')}</label>
                                        <input type="color" id="gen-bg" class="form-input form-color" value="#0f172a">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-surface">${_('generator.surface_color')}</label>
                                        <input type="color" id="gen-surface" class="form-input form-color" value="#1e293b">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-text">${_('generator.text_color')}</label>
                                        <input type="color" id="gen-text" class="form-input form-color" value="#e2e8f0">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-text-muted">${_('generator.text_muted_color')}</label>
                                        <input type="color" id="gen-text-muted" class="form-input form-color" value="#94a3b8">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-status-ready">${_('generator.status_ready_color')}</label>
                                        <input type="color" id="gen-status-ready" class="form-input form-color" value="#22c55e">
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label" for="gen-header-text">${_('generator.header_text_color')}</label>
                                        <input type="color" id="gen-header-text" class="form-input form-color" value="#ffffff">
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group">
                                        <label class="form-label" for="gen-lang">${_('generator.default_lang')}</label>
                                        <select id="gen-lang" class="form-input">
                                            ${(typeof supportedLangs !== 'undefined' ? supportedLangs : ['en', 'pl', 'zh-TW']).map(function(code) {
                                                const label = (typeof localeLabels !== 'undefined' && localeLabels[code]) ? localeLabels[code] : code;
                                                return '<option value="' + code + '">' + label + '</option>';
                                            }).join('')}
                                        </select>
                                    </div>
                                    <div class="form-group form-group-checkbox">
                                        <label class="form-label">
                                            <input type="checkbox" id="gen-unattended">
                                            ${_('generator.allow_unattended')}
                                        </label>
                                        <p class="form-hint">${_('generator.allow_unattended_hint')}</p>
                                    </div>
                                </div>

                                <div id="gen-download-info" class="download-info hidden">
                                    <div class="builds-section" id="gen-builds-section">
                                        <div class="builds-section-header">
                                            <h3 class="section-title">${_('generator.builds_title')}</h3>
                                            <button type="button" id="gen-rebuild-btn" class="btn btn-secondary btn-sm">
                                                <span class="material-icons">sync</span>
                                                ${_('generator.rebuild_all')}
                                            </button>
                                        </div>
                                        <p class="form-hint">${_('generator.builds_hint')}</p>
                                        <div id="gen-toolchain-banner" class="toolchain-banner hidden" role="status"></div>
                                        <div id="gen-builds-summary" class="builds-summary hidden"></div>
                                        <div id="gen-builds-list" class="builds-list">
                                            <p class="text-muted">${_('generator.builds_loading')}</p>
                                        </div>
                                    </div>

                                    <h3 class="section-title">${_('generator.download_link_title')}</h3>
                                    <div class="download-link-row">
                                        <input type="text" id="gen-download-url" class="form-input" readonly>
                                        <button type="button" id="gen-copy-link" class="btn btn-secondary">
                                            <span class="material-icons">content_copy</span>
                                            ${_('copy')}
                                        </button>
                                        <a id="gen-open-link" class="btn btn-ghost" target="_blank" rel="noopener">
                                            <span class="material-icons">open_in_new</span>
                                            ${_('generator.open_portal')}
                                        </a>
                                    </div>
                                    <p class="form-hint">${_('generator.download_link_hint')}</p>
                                </div>
                            </div>

                            <!-- Live preview -->
                            <div class="editor-preview">
                                <h3 class="section-title">${_('generator.preview_title')}</h3>
                                <p class="form-hint">${_('generator.preview_hint')}</p>
                                <div class="agent-preview" id="gen-preview">
                                    <div class="agent-preview-frame" style="--brand-primary: #2563eb; --brand-accent: #1e293b;">
                                        <div class="ap-header">
                                            <div class="ap-brand ap-brand-only">
                                                <div class="ap-brand-name" id="gen-prev-name">${_('generator.preview_default_name')}</div>
                                                <div class="ap-brand-text" id="gen-prev-text"></div>
                                            </div>
                                        </div>
                                        <div class="ap-body">
                                            <div class="ap-body-logo" id="gen-prev-body-logo">
                                                <span class="material-icons">support_agent</span>
                                            </div>
                                            <div class="ap-status">
                                                <span class="ap-status-dot"></span>
                                                <span class="ap-status-text">${_('generator.preview_status_ready')}</span>
                                            </div>
                                            <div class="ap-id-row">
                                                <span class="ap-id-label">${_('generator.preview_id')}</span>
                                                <span class="ap-id-value">123 456 789</span>
                                            </div>
                                            <div class="ap-pw-row" id="gen-prev-pw-row">
                                                <span class="ap-id-label">${_('generator.preview_password')}</span>
                                                <span class="ap-id-value ap-pw">a B 3 # K 9</span>
                                            </div>
                                            <button class="ap-help" type="button" disabled>
                                                <span class="material-icons">contact_support</span>
                                                ${_('generator.preview_help')}
                                            </button>
                                            <button class="ap-chat" type="button" disabled>
                                                <span class="material-icons">chat</span>
                                                ${_('generator.preview_chat')}
                                            </button>
                                        </div>
                                        <div class="ap-footer">
                                            <button class="ap-icon-btn" type="button" disabled title="${_('generator.preview_settings')}">
                                                <span class="material-icons">settings</span>
                                            </button>
                                            <div class="ap-contact" id="gen-prev-contact"></div>
                                            <button class="ap-icon-btn" type="button" disabled title="${_('generator.preview_quit')}">
                                                <span class="material-icons">power_settings_new</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="gen-validation-errors" class="validation-errors hidden"></div>
                    </div>
                </div>
            </section>
        </div>
        ${realClientPanel}

        <!-- GitHub Auto-Provision Modal -->
        <div id="github-provision-modal" class="github-provision-overlay hidden" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 99999; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; padding: 20px;">
            <div class="card" style="width: 100%; max-width: 500px; background: var(--bg-card, #ffffff); border-radius: 12px; padding: 24px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); border: 1px solid var(--border-color, #e2e8f0); position: relative;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                    <h3 style="display: flex; align-items: center; gap: 8px; margin: 0; font-size: 1.25rem; font-weight: 600;">
                        <span class="material-icons" style="color: #6366f1;">auto_awesome</span>
                        ${_('generator.auto_provision_title')}
                    </h3>
                    <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('github-provision-modal').classList.add('hidden')" style="padding: 4px; border-radius: 6px; cursor: pointer;">
                        <span class="material-icons">close</span>
                    </button>
                </div>
                
                <p style="color: var(--text-muted, #64748b); font-size: 0.9em; margin: 0 0 20px 0; line-height: 1.5;">
                    ${_('generator.auto_provision_desc')}
                </p>
                
                <div style="margin-bottom: 20px; padding: 12px; border-radius: 8px; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.2); display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                    <div>
                        <strong style="display: block; font-size: 0.85em; color: #4f46e5;">Need a GitHub Token?</strong>
                        <span style="font-size: 0.8em; color: var(--text-muted);">Click to generate with pre-selected scopes</span>
                    </div>
                    <a href="https://github.com/settings/tokens/new?description=BetterDesk+Build+Repository&scopes=repo,workflow" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="white-space: nowrap; font-size: 0.8em; display: inline-flex; align-items: center; gap: 4px;">
                        <span class="material-icons" style="font-size: 1.1em;">open_in_new</span> Generate PAT
                    </a>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9em;">${_('generator.auto_provision_pat_label')}</label>
                    <input type="password" id="github-pat-input" class="form-control" placeholder="ghp_..." style="width: 100%; box-sizing: border-box; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color, #cbd5e1);">
                </div>
                
                <div class="form-group" style="margin-bottom: 24px;">
                    <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 0.9em;">${_('generator.auto_provision_repo_label')}</label>
                    <input type="text" id="github-repo-name" class="form-control" value="BetterDesk-Client-Builds" style="width: 100%; box-sizing: border-box; padding: 10px; border-radius: 6px; border: 1px solid var(--border-color, #cbd5e1);">
                </div>
                
                <div id="github-provision-status" style="display: none; margin-bottom: 20px; padding: 12px; border-radius: 8px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; font-size: 0.88em;">
                    <span class="material-icons" style="font-size: 1.2em; vertical-align: middle; animation: spin 1s linear infinite; margin-right: 6px;">sync</span>
                    <span id="github-provision-status-text">Provisioning... this may take a minute.</span>
                </div>
                
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('github-provision-modal').classList.add('hidden')">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btn-submit-github-provision" style="display: inline-flex; align-items: center; gap: 6px;">
                        <span class="material-icons" style="font-size: 1.1em;">auto_awesome</span>
                        ${_('generator.auto_provision_start')}
                    </button>
                </div>
            </div>
        </div>
        <style>
        .github-provision-overlay.hidden { display: none !important; }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        </style>
    `
}) %>
